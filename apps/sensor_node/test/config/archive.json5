// The phone's and the archive's session in the monitor's tests: it listens on
// the loopback, connects nowhere, and stamps what it puts.
{
  // A peer: it listens, and it connects to other peers itself.
  mode: "peer",
  scouting: {
    // No multicast scouting: the session asks the network for no one.
    multicast: { enabled: false },
    // No gossip scouting: no node tells this one about the nodes it knows.
    gossip: { enabled: false },
  },
  // Where the session listens: the loopback, port 7448, which no other test
  // folder uses.
  listen: { endpoints: ["tcp/127.0.0.1:7448"] },
  // Timestamping on: the session stamps each sample it publishes with the
  // time of its own clock, as the phone's configuration has it do.
  timestamping: { enabled: true },
}
